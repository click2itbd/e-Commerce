# =========================
# General
# =========================
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://click2itbd.com,https://www.click2itbd.com

# =========================
# Firebase
# =========================
# Path to firebase service account JSON (set on server, do NOT commit the JSON file)
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# =========================
# Dynadot Domain Registrar
# =========================
DYNADOT_API_KEY=
DYNADOT_API_URL=https://api.dynadot.com/api3.json
DYNADOT_SANDBOX_MODE=false
DYNADOT_EXCHANGE_RATE=110
DYNADOT_MARKUP_PERCENT=20

# =========================
# WHM / cPanel Reseller API
# =========================
WHM_API_TYPE=reseller
WHM_API_URL=https://your-server:2087
WHM_API_TOKEN=
WHM_USERNAME=
WHM_VERIFY_SSL=false
WHM_TIMEOUT_MS=30000

# =========================
# SMTP Email
# =========================
SMTP_HOST=mail.click2itbd.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@click2itbd.com
SMTP_FROM_NAME=CLICK2IT

# =========================
# Admin Email Notifications
# =========================
ADMIN_EMAIL=info@click2itbd.com

# =========================
# CloudLinux (optional)
# =========================
CLOUDLINUX_ENABLED=false
CLOUDLINUX_API_URL=
CLOUDLINUX_API_TOKEN=
CLOUDLINUX_PARTNER_LOGIN=
