rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'staff'])
          ||
          (request.auth.token.email != null && request.auth.token.email == 'click2itbd@gmail.com')
        );
    }

    function isManager() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager'])
          ||
          (request.auth.token.email != null && request.auth.token.email == 'click2itbd@gmail.com')
        );
    }

    function isStaff() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'staff'])
          ||
          (request.auth.token.email != null && request.auth.token.email == 'click2itbd@gmail.com')
        );
    }

    function hasStaffAccess() {
      return isAuthenticated();
    }

    function hasManagerAccess() {
      return isAuthenticated();
    }

    function hasPermission(permission) {
      return isAuthenticated();
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ===== PRODUCTS & INVENTORY =====
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // ===== ORDERS & CART =====
    match /orders/{orderId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || resource.data.userId == 'guest'));
      allow create: if true;
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /domainOrders/{orderId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /hostingAccounts/{accountId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /hostingOrders/{orderId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /sslOrders/{orderId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // ===== HOSTING SERVICES & PRICING =====
    match /hostingServices/{serviceId} { allow read: if true; allow write: if isAuthenticated(); }
    match /hostingPlans/{planId} { allow read: if true; allow write: if isAuthenticated(); }
    match /hostingAddonPackages/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /hostingServiceCategories/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /hostingExtraServices/{id} { allow read: if true; allow write: if isAuthenticated(); }
    match /hosting_features/{featureId} { allow read: if true; allow write: if isAuthenticated(); }
    match /custom_hosting_pricing/{pricingId} { allow read: if true; allow write: if isAuthenticated(); }
    match /specialPlans/{planId} { allow read: if true; allow write: if isAuthenticated(); }
    match /domainPricing/{tld} { allow read: if true; allow write: if isAuthenticated(); }
    match /domain_pricing/{tld} { allow read: if true; allow write: if isAuthenticated(); }
    match /domain_offers/{offerId} { allow read: if true; allow write: if isAuthenticated(); }
    match /hosting_config/{docId} { allow read: if true; allow write: if isAuthenticated(); }

    // ===== TICKETS & SUPPORT =====
    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isAuthenticated();
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ===== CUSTOMERS & VENDORS & POS =====
    match /customers/{customerId} {
      allow read: if isStaff() || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAuthenticated();
      allow update: if isStaff() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    match /vendors/{vendorId} { allow read, write: if isAuthenticated(); }
    match /transactions/{transactionId} { allow read, write: if isAuthenticated(); }
    match /transaction_categories/{categoryId} { allow read, write: if isAuthenticated(); }
    match /payment_accounts/{id} { allow read, write: if isAuthenticated(); }
    match /purchases/{purchaseId} { allow read, write: if isAuthenticated(); }
    match /purchase_returns/{returnId} { allow read, write: if isAuthenticated(); }
    match /sale_returns/{returnId} { allow read, write: if isAuthenticated(); }
    match /cash_register/{id} { allow read, write: if isAuthenticated(); }

    // ===== WALLET, AFFILIATE & PAYOUTS =====
    match /topup_requests/{id} { allow read, write: if isAuthenticated(); }
    match /payout_requests/{id} { allow read, write: if isAuthenticated(); }
    match /affiliate_commissions/{id} { allow read, write: if isAuthenticated(); }
    match /wallet_transactions/{id} { allow read, write: if isAuthenticated(); }

    // ===== SETTINGS & MENUS =====
    match /settings/{settingId} { allow read: if true; allow write: if isAuthenticated(); }
    match /menus/{menuId} { allow read: if true; allow write: if isAuthenticated(); }
    match /store_banners/{bannerId} { allow read: if true; allow write: if isAuthenticated(); }
    match /store_brands/{brandId} { allow read: if true; allow write: if isAuthenticated(); }
    match /brands/{brandId} { allow read: if true; allow write: if isAuthenticated(); }
    match /models/{modelId} { allow read: if true; allow write: if isAuthenticated(); }
    match /variants/{variantId} { allow read: if true; allow write: if isAuthenticated(); }
    match /product_categories/{categoryId} { allow read: if true; allow write: if isAuthenticated(); }
    match /pages/{pageId} { allow read: if true; allow write: if isAuthenticated(); }

    // ===== MISC APP COLLECTIONS =====
    match /subscribers/{subscriberId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /reviews/{reviewId} { allow read: if true; allow write: if isAuthenticated(); }
    match /inquiries/{inquiryId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /discountCodes/{discountCodeId} { allow read: if true; allow write: if isAuthenticated(); }
    match /couponCodes/{couponCodeId} { allow read: if true; allow write: if isAuthenticated(); }
    match /campaigns/{campaignId} { allow read, write: if isAuthenticated(); }
    match /tasks/{taskId} { allow read, write: if isAuthenticated(); }
    match /counters/{counterId} { allow read, write: if true; }
    match /nameserver_requests/{requestId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /domain_transfers/{transferId} { allow read, write: if isAuthenticated(); }
    match /bd_domain_applications/{applicationId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /price_alerts/{alertId} { allow read, write: if true; }
    match /quote_requests/{requestId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /showcase_projects/{projectId} { allow read: if true; allow write: if isAuthenticated(); }
    match /saved_builds/{buildId} { allow read, write: if isAuthenticated(); }
    match /returns/{returnId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /ecommerce_blog/{postId} { allow read: if true; allow write: if isAuthenticated(); }
    match /pc_builder_categories/{categoryId} { allow read: if true; allow write: if isAuthenticated(); }
    match /buildRequests/{requestId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /wishlists/{userId} { allow read, write: if isAuthenticated(); }
    match /abandoned_carts/{cartId} { allow read, write: if true; }
    match /community_builds/{buildId} { allow read, write: if true; }
    match /pre_bookings/{bookingId} { allow create: if true; allow read, write: if isAuthenticated(); }
    match /servers/{serverId} { allow read, write: if isAuthenticated(); }
    match /provisioningLogs/{logId} { allow read, write: if isAuthenticated(); }
    match /apiLogs/{logId} { allow read, write: if isAuthenticated(); }
    match /emailLogs/{logId} { allow read, write: if true; }
    match /paymentAuditLog/{logId} { allow read, write: if true; }
    match /emailTemplates/{templateId} { allow read, write: if true; }
    match /audit_logs/{logId} { allow read, write: if isAuthenticated(); }
  }
}
