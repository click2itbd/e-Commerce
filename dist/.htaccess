<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forward /api requests to the Node.js backend on 103.49.202.200:4000
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^api/(.*)$ http://103.49.202.200:4000/api/$1 [P,L]
  RewriteRule ^api$ http://103.49.202.200:4000/api/ [P,L]

  # Direct all other routes to React Single Page App (index.html)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>